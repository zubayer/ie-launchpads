{
  "name": "ie-launchpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "vitest run",
    "docs:gaps": "vitest run --config vitest.docs.config.ts scripts/gap-analysis.gen.ts",
    "audit": "node scripts/browser-audit.mjs",
    "docs:coverage": "vitest run --config vitest.docs.config.ts scripts/coverage.gen.ts",
    "docs": "vitest run --config vitest.docs.config.ts",
    "size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "d3-force": "^3.0.1",
    "fuse.js": "^7.5.0",
    "javascript-lp-solver": "^1.0.3",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sql.js": "^1.17.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
